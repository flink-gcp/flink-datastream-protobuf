{
  "config": {
    "MD013": false,
    "MD025": { "front_matter_title": "" },
    "MD052": { "shortcut_syntax": true },
    "MD060": false
  },
  "overrides": [
    {
      "filter": ["docs/content/**/*.md"],
      "config": { "MD052": { "shortcut_syntax": false } },
      "combine": "merge"
    }
  ],
  "ignores": ["docs/public/**", "docs/resources/**", "docs/static/**"],
  "globs": ["README.md", "CONTRIBUTING.md", "docs/**/*.md"]
}
