<!--
CI-only Maven settings that the .github/actions/maven action passes through MAVEN_ARGS
(issue #135): Google's mirror of Maven Central is a repository ahead of Central, not a
<mirror> of it. "CI Maven resolution" in docs/development.md describes the boundary.
-->
<settings xmlns="http://maven.apache.org/SETTINGS/1.2.0">
    <profiles>
        <profile>
            <id>google-maven-central</id>
            <repositories>
                <repository>
                    <id>google-maven-central</id>
                    <url>https://maven-central.storage-download.googleapis.com/maven2/</url>
                    <snapshots>
                        <enabled>false</enabled>
                    </snapshots>
                </repository>
            </repositories>
            <pluginRepositories>
                <pluginRepository>
                    <id>google-maven-central</id>
                    <url>https://maven-central.storage-download.googleapis.com/maven2/</url>
                    <snapshots>
                        <enabled>false</enabled>
                    </snapshots>
                </pluginRepository>
            </pluginRepositories>
        </profile>
    </profiles>
    <activeProfiles>
        <activeProfile>google-maven-central</activeProfile>
    </activeProfiles>
</settings>
