<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.apache.flink</groupId>
        <artifactId>flink-connector-parent</artifactId>
        <version>2.0.0</version>
        <relativePath/>
    </parent>
    <groupId>io.github.flink-gcp</groupId>
    <artifactId>flink-datastream-protobuf</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>Flink DataStream Protobuf</name>
    <description>Native Protocol Buffers type integration for Apache Flink DataStream, with explicit type information, factory registration, and versioned descriptor snapshots for unchanged-schema serializer restoration.</description>
    <url>https://github.com/flink-gcp/flink-datastream-protobuf</url>
    <inceptionYear>2026</inceptionYear>
    <licenses>
        <license>
            <name>The Apache Software License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>
    <organization>
        <name>The flink-gcp authors</name>
        <url>https://github.com/flink-gcp</url>
    </organization>
    <developers>
        <developer><name>The flink-gcp authors</name><url>https://github.com/flink-gcp</url></developer>
    </developers>
    <scm>
        <url>https://github.com/flink-gcp/flink-datastream-protobuf</url>
        <connection>scm:git:https://github.com/flink-gcp/flink-datastream-protobuf.git</connection>
        <developerConnection>scm:git:git@github.com:flink-gcp/flink-datastream-protobuf.git</developerConnection>
    </scm>
    <properties>
        <flink.version>2.2.1</flink.version>
        <flink.compat>flink2</flink.compat>
        <flink.compat.pattern>flink2</flink.compat.pattern>
        <flink.version.pattern>2\..+</flink.version.pattern>
        <test.production.classes>${project.build.outputDirectory}</test.production.classes>
        <flink.parent.artifactId>flink-datastream-protobuf</flink.parent.artifactId>
        <protobuf.version>3.25.9</protobuf.version>
        <protoc.version>${protobuf.version}</protoc.version>
        <protobuf-maven-plugin.version>5.1.8</protobuf-maven-plugin.version>
        <junit5.version>5.14.4</junit5.version>
        <assertj.version>3.27.7</assertj.version>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <maven.compiler.release>17</maven.compiler.release>
        <test.excluded.groups>chill</test.excluded.groups>
        <flink.forkCountUnitTest>1</flink.forkCountUnitTest>
        <flink.forkCountITCase>1</flink.forkCountITCase>
        <!-- No module-opening flags: native integration and probes must work without Kryo reflection. -->
        <flink.surefire.baseArgLine>-Xms128m -XX:+UseG1GC</flink.surefire.baseArgLine>
        <flink.XmxITCase>1024m</flink.XmxITCase>
    </properties>
    <dependencyManagement>
        <dependencies>
            <dependency><groupId>org.junit</groupId><artifactId>junit-bom</artifactId><version>${junit5.version}</version><type>pom</type><scope>import</scope></dependency>
        </dependencies>
    </dependencyManagement>
    <dependencies>
        <dependency><groupId>org.apache.flink</groupId><artifactId>flink-core</artifactId><version>${flink.version}</version><scope>provided</scope></dependency>
        <dependency><groupId>com.google.protobuf</groupId><artifactId>protobuf-java</artifactId><version>${protobuf.version}</version><scope>provided</scope></dependency>
        <dependency><groupId>org.apache.flink</groupId><artifactId>flink-streaming-java</artifactId><version>${flink.version}</version><scope>test</scope></dependency>
        <dependency><groupId>org.apache.flink</groupId><artifactId>flink-clients</artifactId><version>${flink.version}</version><scope>test</scope></dependency>
        <dependency><groupId>org.apache.flink</groupId><artifactId>flink-statebackend-rocksdb</artifactId><version>${flink.version}</version><scope>test</scope></dependency>
        <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><scope>test</scope></dependency>
        <dependency><groupId>org.assertj</groupId><artifactId>assertj-core</artifactId><version>${assertj.version}</version><scope>test</scope></dependency>
        <dependency><groupId>org.slf4j</groupId><artifactId>slf4j-simple</artifactId><version>1.7.36</version><scope>test</scope></dependency>
    </dependencies>
    <build>
        <resources>
            <resource><directory>src/main/resources</directory></resource>
            <resource><directory>${project.basedir}</directory><targetPath>META-INF</targetPath><includes><include>LICENSE</include><include>NOTICE</include></includes></resource>
        </resources>
        <plugins>
            <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId>
                <executions>
                    <execution><id>compile-runtime-original</id><phase>test-compile</phase><goals><goal>testCompile</goal></goals><configuration>
                        <compileSourceRoots><compileSourceRoot>${project.basedir}/src/test/runtime-app/java</compileSourceRoot><compileSourceRoot>${project.build.directory}/runtime-app/original/generated</compileSourceRoot></compileSourceRoots>
                        <outputDirectory>${project.build.directory}/runtime-app/original/classes</outputDirectory>
                    </configuration></execution>
                    <execution><id>compile-runtime-changed</id><phase>test-compile</phase><goals><goal>testCompile</goal></goals><configuration>
                        <compileSourceRoots><compileSourceRoot>${project.basedir}/src/test/runtime-app/java</compileSourceRoot><compileSourceRoot>${project.build.directory}/runtime-app/changed/generated</compileSourceRoot></compileSourceRoots>
                        <outputDirectory>${project.build.directory}/runtime-app/changed/classes</outputDirectory>
                    </configuration></execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>com.diffplug.spotless</groupId><artifactId>spotless-maven-plugin</artifactId>
                <!-- Keep formatting active on both JDKs despite the parent's java21 profile. -->
                <configuration><skip>false</skip><java><includes><include>src/**/*.java</include></includes></java></configuration>
            </plugin>
            <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-checkstyle-plugin</artifactId>
                <configuration><sourceDirectories combine.self="override">
                    <sourceDirectory>src/main/java</sourceDirectory><sourceDirectory>src/test/java</sourceDirectory>
                    <sourceDirectory>src/test/runtime-app/java</sourceDirectory>
                    <sourceDirectory>src/main/java-flink1</sourceDirectory><sourceDirectory>src/main/java-flink2</sourceDirectory>
                    <sourceDirectory>src/test/java-flink1</sourceDirectory><sourceDirectory>src/test/java-flink2</sourceDirectory>
                </sourceDirectories></configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId><artifactId>maven-enforcer-plugin</artifactId>
                <executions><execution><id>validate-flink-toolchain</id><goals><goal>enforce</goal></goals><configuration><rules>
                    <requireProperty><property>flink.compat</property><regex>${flink.compat.pattern}</regex><regexMessage>Use flink.compat=flink1 with the flink1 profile, or flink2 without that profile.</regexMessage></requireProperty>
                    <requireProperty><property>flink.version</property><regex>${flink.version.pattern}</regex><regexMessage>The Flink version must match the selected flink.compat source root.</regexMessage></requireProperty>
                </rules></configuration></execution></executions>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId><artifactId>build-helper-maven-plugin</artifactId><version>3.6.1</version>
                <executions><execution><id>add-flink-compat-sources</id><phase>generate-sources</phase><goals><goal>add-source</goal></goals>
                    <configuration><sources><source>src/main/java-${flink.compat}</source></sources></configuration>
                </execution><execution><id>add-flink-compat-tests</id><phase>generate-test-sources</phase><goals><goal>add-test-source</goal></goals>
                    <configuration><sources><source>src/test/java-${flink.compat}</source></sources></configuration>
                </execution></executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <excludedGroups>${test.excluded.groups}</excludedGroups>
                    <classesDirectory>${test.production.classes}</classesDirectory>
                    <!-- Factory registrations are process-global; controls need fresh JVMs. -->
                    <reuseForks>false</reuseForks>
                    <failIfNoTests>true</failIfNoTests>
                    <systemPropertyVariables>
                        <org.slf4j.simpleLogger.defaultLogLevel>error</org.slf4j.simpleLogger.defaultLogLevel>
                        <protobuf.test.flink.version>${flink.version}</protobuf.test.flink.version>
                        <protobuf.test.protobuf.version>${protobuf.version}</protobuf.test.protobuf.version>
                        <protobuf.test.protoc.version>${protoc.version}</protobuf.test.protoc.version>
                        <protobuf.test.library.version>${project.version}</protobuf.test.library.version>
                        <protobuf.test.runtime.apps>${project.build.directory}/runtime-app</protobuf.test.runtime.apps>
                        <protobuf.test.production.classes>${test.production.classes}</protobuf.test.production.classes>
                    </systemPropertyVariables>
                </configuration>
                <executions>
                    <execution><id>integration-tests</id><configuration><includes combine.self="override"><include>**/*ITCase.java</include></includes></configuration></execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>io.github.ascopes</groupId><artifactId>protobuf-maven-plugin</artifactId><version>${protobuf-maven-plugin.version}</version>
                <configuration><protoc>${protoc.version}</protoc></configuration>
                <executions><execution><id>generate-test-protobuf</id><goals><goal>generate-test</goal></goals></execution>
                    <execution><id>generate-runtime-original</id><goals><goal>generate-test</goal></goals><configuration>
                        <sourceDirectories><sourceDirectory>${project.basedir}/src/test/runtime-app/proto/original</sourceDirectory></sourceDirectories>
                        <outputDirectory>${project.build.directory}/runtime-app/original/generated</outputDirectory>
                        <registerAsCompilationRoot>false</registerAsCompilationRoot><embedSourcesInClassOutputs>false</embedSourcesInClassOutputs>
                        <outputDescriptorFile>${project.build.directory}/runtime-app/original/schema.pb</outputDescriptorFile><outputDescriptorIncludeImports>true</outputDescriptorIncludeImports>
                    </configuration></execution>
                    <execution><id>generate-runtime-changed</id><goals><goal>generate-test</goal></goals><configuration>
                        <sourceDirectories><sourceDirectory>${project.basedir}/src/test/runtime-app/proto/changed</sourceDirectory></sourceDirectories>
                        <outputDirectory>${project.build.directory}/runtime-app/changed/generated</outputDirectory>
                        <registerAsCompilationRoot>false</registerAsCompilationRoot><embedSourcesInClassOutputs>false</embedSourcesInClassOutputs>
                        <outputDescriptorFile>${project.build.directory}/runtime-app/changed/schema.pb</outputDescriptorFile><outputDescriptorIncludeImports>true</outputDescriptorIncludeImports>
                    </configuration></execution></executions>
            </plugin>
            <!-- Use this project's complete notices rather than an ASF resource bundle. -->
            <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-remote-resources-plugin</artifactId><configuration><skip>true</skip></configuration></plugin>
            <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-jar-plugin</artifactId></plugin>
            <!-- These application jars are test inputs, never attached publication artifacts. -->
            <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-antrun-plugin</artifactId><version>3.1.0</version>
                <executions><execution><id>package-runtime-applications</id><phase>process-test-classes</phase><goals><goal>run</goal></goals><configuration><skip>${maven.test.skip}</skip><target>
                    <jar destfile="${project.build.directory}/runtime-app/application-original.jar" basedir="${project.build.directory}/runtime-app/original/classes"/>
                    <jar destfile="${project.build.directory}/runtime-app/application-changed.jar" basedir="${project.build.directory}/runtime-app/changed/classes"/>
                </target></configuration></execution></executions>
            </plugin>
            <plugin>
                <groupId>org.apache.rat</groupId><artifactId>apache-rat-plugin</artifactId>
                <configuration>
                    <numUnapprovedLicenses>0</numUnapprovedLicenses>
                    <addDefaultLicenseMatchers>false</addDefaultLicenseMatchers>
                    <licenses><license implementation="org.apache.rat.analysis.license.SimplePatternBasedLicense">
                        <licenseFamilyCategory>AL2</licenseFamilyCategory><licenseFamilyName>Apache License 2.0</licenseFamilyName>
                        <patterns><pattern>Licensed under the Apache License, Version 2.0</pattern><pattern>Licensed to the Apache Software Foundation (ASF) under one</pattern></patterns>
                    </license></licenses>
                    <licenseFamilies><licenseFamily implementation="org.apache.rat.license.SimpleLicenseFamily"><familyName>Apache License 2.0</familyName></licenseFamily></licenseFamilies>
                    <excludes>
                        <exclude>**/.*</exclude><exclude>**/.*/**</exclude><exclude>**/target/**</exclude>
                        <exclude>LICENSE</exclude><exclude>NOTICE</exclude><exclude>mvnw</exclude><exclude>mvnw.cmd</exclude>
                        <exclude>mise.toml</exclude><exclude>mise.local.toml</exclude><exclude>**/*.log</exclude>
                        <exclude>README.md</exclude><exclude>AGENTS.md</exclude><exclude>CLAUDE.md</exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>
    <profiles>
        <profile><id>flink1</id><activation><property><name>flink.compat</name><value>flink1</value></property></activation>
            <properties><flink.version>1.20.4</flink.version><flink.compat>flink1</flink.compat><flink.compat.pattern>flink1</flink.compat.pattern><flink.version.pattern>1\.20\..+</flink.version.pattern></properties>
        </profile>
        <profile><id>protobuf3</id></profile>
        <profile><id>protobuf4</id><properties><protobuf.version>4.33.6</protobuf.version></properties></profile>
        <profile><id>chill</id><dependencies>
            <dependency><groupId>com.twitter</groupId><artifactId>chill-protobuf</artifactId><version>0.10.0</version><scope>test</scope></dependency>
        </dependencies></profile>
    </profiles>
</project>
